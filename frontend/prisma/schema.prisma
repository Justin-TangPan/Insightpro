generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// This schema documents the public tables used by the FastAPI backend.
// Supabase Auth users live outside this public application schema.

model GithubTrending {
  id          Int      @id @default(autoincrement())
  scrapeDate  String   @map("scrape_date")
  scrapeTime  String   @map("scrape_time")
  repoName    String   @map("repo_name")
  repoUrl     String?  @map("repo_url")
  description String?
  language    String?
  stars       String?
  forks       String?
  todayStars  String?  @map("today_stars")
  tags        String?
  category    String   @default("daily")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, category, repoName])
  @@index([scrapeDate])
  @@index([category])
  @@map("github_trending")
}

model BaiduHotsearch {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  scrapeTime String   @map("scrape_time")
  rank       Int?
  title      String
  hot        String?
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, title])
  @@index([scrapeDate])
  @@map("baidu_hotsearch")
}

model ScrapeLog {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  scrapeTime String   @map("scrape_time")
  status     String
  itemsCount Int?     @map("items_count")
  errorMsg   String?  @map("error_msg")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("scrape_log")
}

model PageVisit {
  id        Int      @id @default(autoincrement())
  pagePath  String   @map("page_path")
  visitorId String   @map("visitor_id")
  userAgent String?  @map("user_agent")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pagePath])
  @@index([createdAt])
  @@index([visitorId])
  @@map("page_visits")
}

model EmailSubscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String?
  active     Int       @default(1)
  weekdays   Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  sendTime   String    @default("09:05") @map("send_time")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("email_subscribers")
}

model CompetitorNews {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  vendor     String
  title      String
  link       String?
  summary    String?
  category   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, vendor, title])
  @@index([scrapeDate])
  @@index([vendor])
  @@map("competitor_news")
}

model CloudVendorNews {
  id        Int      @id @default(autoincrement())
  crawlDate String   @map("crawl_date")
  vendor    String
  title     String
  summary   String?
  url       String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([crawlDate, vendor, title])
  @@index([crawlDate])
  @@map("cloud_vendor_news")
}

model TrendingBusinessEval {
  id             Int      @id @default(autoincrement())
  scrapeDate     String   @map("scrape_date")
  repoName       String   @map("repo_name")
  repoUrl        String?  @map("repo_url")
  language       String?
  stars          String?
  summary        String?
  d1             Float?
  d2             Float?
  d3             Float?
  d4             Float?
  total          Float?
  level          String?
  recommendation String?
  reasoning      String?
  evalTime       String?  @map("eval_time")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, repoName])
  @@index([scrapeDate])
  @@map("trending_business_eval")
}

model InsightTask {
  id          String   @id
  title       String
  status      String   @default("pending")
  dataSources Json?    @map("data_sources")
  result      Json?
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("insight_tasks")
}

model AliyunSolution {
  id                Int      @id @default(autoincrement())
  title             String
  url               String   @unique
  category          String
  sourceDescription String?  @map("source_description")
  summary           String
  contentHash       String   @map("content_hash")
  firstSeenDate     String   @map("first_seen_date")
  lastSeenDate      String   @map("last_seen_date")
  lastChangedDate   String   @map("last_changed_date")
  isActive          Boolean  @default(true) @map("is_active")
  isBaseline        Boolean  @default(false) @map("is_baseline")
  menuOrder         Int      @default(0) @map("menu_order")
  removedAt         DateTime? @map("removed_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@index([lastSeenDate])
  @@index([lastChangedDate])
  @@map("aliyun_solutions")
}

model Requirement {
  id          BigInt                @id @default(autoincrement())
  userId      String                @db.Uuid @map("user_id")
  title       String
  description String                @default("")
  status      String                @default("draft")
  priority    String                @default("medium")
  sourceType  String                @default("manual") @map("source_type")
  sourceId    String?               @map("source_id")
  sourceUrl   String?               @map("source_url")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  solutions   RequirementSolution[]

  @@index([userId, status, updatedAt])
  @@map("requirements")
}

model Solution {
  id           BigInt                @id @default(autoincrement())
  userId       String                @db.Uuid @map("user_id")
  name         String
  description  String                @default("")
  category     String                @default("未分类")
  status       String                @default("draft")
  version      String                @default("v0.1.0")
  referenceUrl String?               @map("reference_url")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  requirements RequirementSolution[]

  @@index([userId, status, updatedAt])
  @@map("solutions")
}

model RequirementSolution {
  requirementId BigInt      @map("requirement_id")
  solutionId    BigInt      @map("solution_id")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  solution      Solution    @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@id([requirementId, solutionId])
  @@index([solutionId])
  @@map("requirement_solutions")
}

model OpenCodeSsoTicket {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  targetUserId String? @map("target_user_id") @db.Uuid
  agentSessionId String? @map("agent_session_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("opencode_sso_tickets")
}

model OpenCodeSsoSession {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  agentUserId String  @map("agent_user_id") @db.Uuid
  authRole String     @default("user") @map("auth_role")
  agentRole String    @default("user") @map("agent_role")
  displayName String  @default("") @map("display_name")
  agentSessionId String? @map("agent_session_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, expiresAt])
  @@map("opencode_sso_sessions")
}

model AgentSession {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  contextType     String   @map("context_type")
  contextId       String   @map("context_id")
  contextTitle    String   @map("context_title")
  contextSnapshot Json     @map("context_snapshot")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([userId, updatedAt])
  @@map("agent_sessions")
}

model AgentAction {
  id          String   @id @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  payload     Json
  status      String   @default("proposed")
  result      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz

  @@index([userId, status, createdAt])
  @@map("agent_actions")
}
