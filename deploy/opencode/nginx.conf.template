server {
    listen 8080;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "healthy\n";
    }

    location = /_insight_auth {
        internal;
        proxy_pass ${INSIGHT_AUTH_VERIFY_URL};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Insight-Gateway-Secret "${OPENCODE_GATEWAY_SECRET}";
    }

    location = /auth/callback {
        access_log off;
        set $sso_ticket $arg_ticket;
        set $args "";
        proxy_pass ${INSIGHT_AUTH_CALLBACK_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Insight-SSO-Ticket $sso_ticket;
    }

    location = /insight-agent-bootstrap.js {
        default_type application/javascript;
        alias /etc/nginx/insight-agent/bootstrap.js;
        add_header Cache-Control "no-store";
    }

    location / {
        auth_request /_insight_auth;
        error_page 401 = @insight_login;

        proxy_pass http://opencode:4096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization "Basic ${OPENCODE_BASIC_AUTH}";
        proxy_set_header Cookie "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_hide_header WWW-Authenticate;
        add_header Content-Security-Policy "frame-ancestors ${INSIGHT_APP_ORIGIN}" always;
        sub_filter '</head>' '<script src="/insight-agent-bootstrap.js"></script></head>';
        sub_filter_once on;
    }

    location @insight_login {
        return 302 "${INSIGHT_LOGIN_URL}?next=/auth/opencode";
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
