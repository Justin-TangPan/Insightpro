server {
    listen 8080;
    server_name _;

    location = /healthz {
        access_log off;
        return 200 "healthy\n";
    }

    location = /_insight_auth {
        internal;
        proxy_pass ${INSIGHT_AUTH_VERIFY_URL};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Insight-Gateway-Secret "${OPENCODE_GATEWAY_SECRET}";
    }

    location = /auth/callback {
        access_log off;
        set $sso_ticket $arg_ticket;
        set $args "";
        proxy_pass ${INSIGHT_AUTH_CALLBACK_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Insight-SSO-Ticket $sso_ticket;
    }

    location = /__insight/context {
        auth_request /_insight_auth;
        auth_request_set $agent_user_id $upstream_http_x_insight_user_id;
        auth_request_set $agent_role $upstream_http_x_insight_agent_role;
        auth_request_set $auth_role $upstream_http_x_insight_auth_role;
        auth_request_set $display_name $upstream_http_x_insight_display_name;

        proxy_pass http://hermes:4096;
        proxy_set_header X-Insight-User-Id $agent_user_id;
        proxy_set_header X-Insight-Agent-Role $agent_role;
        proxy_set_header X-Insight-Auth-Role $auth_role;
        proxy_set_header X-Insight-Display-Name $display_name;
        proxy_set_header X-Insight-Runtime-Secret "${OPENCODE_GATEWAY_SECRET}";
    }

    location / {
        auth_request /_insight_auth;
        error_page 401 = @insight_login;
        auth_request_set $agent_user_id $upstream_http_x_insight_user_id;
        auth_request_set $agent_role $upstream_http_x_insight_agent_role;
        auth_request_set $auth_role $upstream_http_x_insight_auth_role;
        auth_request_set $display_name $upstream_http_x_insight_display_name;

        proxy_pass http://hermes:4096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Insight-User-Id $agent_user_id;
        proxy_set_header X-Insight-Agent-Role $agent_role;
        proxy_set_header X-Insight-Auth-Role $auth_role;
        proxy_set_header X-Insight-Display-Name $display_name;
        proxy_set_header X-Insight-Runtime-Secret "${OPENCODE_GATEWAY_SECRET}";
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_hide_header WWW-Authenticate;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "frame-ancestors ${INSIGHT_APP_ORIGIN}" always;
    }

    location @insight_login {
        return 302 "${INSIGHT_LOGIN_URL}?next=/auth/opencode";
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
