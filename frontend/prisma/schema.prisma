generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// This schema documents the public tables used by the FastAPI backend.
// Supabase Auth users live outside this public application schema.

model GithubTrending {
  id          Int      @id @default(autoincrement())
  scrapeDate  String   @map("scrape_date")
  scrapeTime  String   @map("scrape_time")
  repoName    String   @map("repo_name")
  repoUrl     String?  @map("repo_url")
  description String?
  language    String?
  stars       String?
  forks       String?
  todayStars  String?  @map("today_stars")
  tags        String?
  category    String   @default("daily")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, category, repoName])
  @@index([scrapeDate])
  @@index([category])
  @@map("github_trending")
}

model BaiduHotsearch {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  scrapeTime String   @map("scrape_time")
  rank       Int?
  title      String
  hot        String?
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, title])
  @@index([scrapeDate])
  @@map("baidu_hotsearch")
}

model ScrapeLog {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  scrapeTime String   @map("scrape_time")
  status     String
  itemsCount Int?     @map("items_count")
  errorMsg   String?  @map("error_msg")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("scrape_log")
}

model PageVisit {
  id        Int      @id @default(autoincrement())
  pagePath  String   @map("page_path")
  visitorId String   @map("visitor_id")
  userAgent String?  @map("user_agent")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pagePath])
  @@index([createdAt])
  @@index([visitorId])
  @@map("page_visits")
}

model EmailSubscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String?
  active     Int       @default(1)
  weekdays   Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  sendTime   String    @default("09:05") @map("send_time")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("email_subscribers")
}

model CompetitorNews {
  id         Int      @id @default(autoincrement())
  scrapeDate String   @map("scrape_date")
  vendor     String
  title      String
  link       String?
  summary    String?
  category   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, vendor, title])
  @@index([scrapeDate])
  @@index([vendor])
  @@map("competitor_news")
}

model CloudVendorNews {
  id        Int      @id @default(autoincrement())
  crawlDate String   @map("crawl_date")
  vendor    String
  title     String
  summary   String?
  url       String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([crawlDate, vendor, title])
  @@index([crawlDate])
  @@map("cloud_vendor_news")
}

model IndustryNews {
  id        Int      @id @default(autoincrement())
  crawlDate String   @map("crawl_date")
  source    String
  title     String
  summary   String?
  url       String?
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([crawlDate, source, title])
  @@index([crawlDate])
  @@map("industry_news")
}

model PolicyUpdate {
  id        Int      @id @default(autoincrement())
  crawlDate String   @map("crawl_date")
  source    String
  title     String
  summary   String?
  url       String?
  category  String?
  severity  String   @default("medium")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([crawlDate, source, title])
  @@index([crawlDate])
  @@map("policy_updates")
}

model BiddingOpportunity {
  id               Int      @id @default(autoincrement())
  bidDate          String   @map("bid_date")
  industry         String?
  title            String
  procuringEntity  String?  @map("procuring_entity")
  budget           String?
  budgetAmount     Int?     @map("budget_amount")
  deadline         String?
  summary          String?
  requirements     String?
  qualification    String?
  contact          String?
  url              String?
  source           String?
  region           String?
  status           String?
  relevanceScore   Float    @default(0.5) @map("relevance_score")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([bidDate, title])
  @@index([bidDate])
  @@index([industry])
  @@index([status])
  @@index([budgetAmount])
  @@map("bidding_opportunities")
}

model DemandSignal {
  id             Int      @id @default(autoincrement())
  signalDate     String   @map("signal_date")
  sourceType     String?  @map("source_type")
  industry       String?
  title          String
  summary        String?
  url            String?
  relevanceScore Float    @default(0.5) @map("relevance_score")
  demandTags     String?  @map("demand_tags")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([signalDate])
  @@index([industry])
  @@index([sourceType])
  @@map("demand_signals")
}

model DemandReport {
  id         Int      @id @default(autoincrement())
  reportDate String?  @map("report_date")
  industry   String?
  title      String?
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([reportDate])
  @@map("demand_reports")
}

model TrendingBusinessEval {
  id             Int      @id @default(autoincrement())
  scrapeDate     String   @map("scrape_date")
  repoName       String   @map("repo_name")
  repoUrl        String?  @map("repo_url")
  language       String?
  stars          String?
  summary        String?
  d1             Float?
  d2             Float?
  d3             Float?
  d4             Float?
  total          Float?
  level          String?
  recommendation String?
  reasoning      String?
  evalTime       String?  @map("eval_time")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scrapeDate, repoName])
  @@index([scrapeDate])
  @@map("trending_business_eval")
}

model InsightTask {
  id          String   @id
  title       String
  status      String   @default("pending")
  dataSources Json?    @map("data_sources")
  result      Json?
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("insight_tasks")
}

model AliyunSolution {
  id                Int      @id @default(autoincrement())
  title             String
  url               String   @unique
  category          String
  sourceDescription String?  @map("source_description")
  summary           String
  contentHash       String   @map("content_hash")
  firstSeenDate     String   @map("first_seen_date")
  lastSeenDate      String   @map("last_seen_date")
  lastChangedDate   String   @map("last_changed_date")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@index([lastSeenDate])
  @@index([lastChangedDate])
  @@map("aliyun_solutions")
}
