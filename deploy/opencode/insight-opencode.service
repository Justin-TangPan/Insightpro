[Unit]
Description=InsightPro OpenCode AI Agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/AIProject/insight-web
ExecStart=/root/AIProject/insight-web/deploy/opencode/manage.sh start
ExecStop=/root/AIProject/insight-web/deploy/opencode/manage.sh stop
ExecReload=/root/AIProject/insight-web/deploy/opencode/manage.sh upgrade
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
