{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "insight-provider/glm-5.2",
  "provider": {
    "insight-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InsightPro Model Provider",
      "options": {
        "baseURL": "{env:OPENCODE_PROVIDER_BASE_URL}",
        "apiKey": "{env:OPENCODE_PROVIDER_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          "temperature": true
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "insight_public_data": "allow",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
