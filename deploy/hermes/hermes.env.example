HERMES_BIND_ADDRESS=0.0.0.0
HERMES_PORT=4096
HERMES_DATA_ROOT=/var/lib/insight-hermes
HERMES_DISK_BUDGET_MB=20480
HERMES_MAX_ACTIVE=6
HERMES_IDLE_SECONDS=1800
HERMES_PROVIDER_BASE_URL=https://provider.example/v1
HERMES_PROVIDER_API_KEY=replace-with-a-dedicated-provider-key
INSIGHT_AUTH_VERIFY_URL=http://host.docker.internal:8000/api/auth/agent/verify
INSIGHT_AUTH_CALLBACK_URL=http://host.docker.internal:8000/api/auth/agent/callback
INSIGHT_APP_ORIGIN=
INSIGHT_LOGIN_URL=
INSIGHT_HOST_GATEWAY=172.17.0.1
INSIGHT_PUBLIC_API_URL=http://host.docker.internal:8000/api
